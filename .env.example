# Adobe Experience Platform 설정
EDGE_CONFIG_ID=your-edge-config-id-here
ORG_ID=your-org-id@AdobeOrg

# Firebase Admin SDK 설정 (Heroku/프로덕션 환경용)
# 아래 형식으로 Firebase 서비스 계정 키 전체를 JSON 문자열로 입력
# 로컬 개발 환경에서는 ./config/adobe-demo-app-service-key.json 파일 사용
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
